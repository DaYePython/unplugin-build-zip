{
  "name": "unplugin-build-zip-monorepo",
  "private": true,
  "packageManager": "pnpm@10.14.0",
  "scripts": {
    "build": "pnpm -r --filter=./packages/* run build",
    "test": "vitest run",
    "lint": "eslint .",
    "changelog": "conventional-changelog -p angular -i CHANGELOG.md -s -r 0",
    "release": "bumpp package.json packages/unplugin-build-zip/package.json && pnpm changelog && pnpm -F @daye-cli/unplugin-build-zip publish",
    "prepare": "husky"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^4.13.2",
    "bumpp": "10.4.1",
    "conventional-changelog": "^7.2.0",
    "conventional-changelog-angular": "^8.3.1",
    "eslint": "^9.27.0",
    "husky": "^9.1.7",
    "typescript": "^5.8.3",
    "vitest": "^3.1.4"
  }
}
